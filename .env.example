# ==============================================================================
# SCOUT ENVIRONMENT CONFIGURATION
# ==============================================================================

# ─── TinyFish API (Required for web research, fetch, and agent) ───────────────
# Get your API key from https://agent.tinyfish.ai
TINYFISH_API_KEY=

# ─── Photon Spectrum (For iMessage connectivity) ──────────────────────────────
# From your Photon dashboard (https://photon.codes)
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# ─── Storage ──────────────────────────────────────────────────────────────────
# Scout uses zero-setup local persistent file storage (data/store.json).
# No MongoDB Atlas setup is required.

# ─── Intelligence ─────────────────────────────────────────────────────────────
# Scout research and extraction is driven exclusively by TinyFish (Search, Fetch, Agent).
# No external LLMs (OpenAI, Anthropic, etc.) are needed.
